# Copy to .env for local overrides. All variables are optional.

# --- Python backend / ingestion ---
# Absolute path to the DuckDB warehouse file used for reads and writes.
# Default: data/warehouse/university_intel.duckdb
UNI_INTEL_DB_PATH=

# Where the API inflates the gzipped warehouse archive in serverless
# environments. Default: /tmp/university_intel.duckdb
UNI_INTEL_RUNTIME_DB_PATH=

# Optional URL to a gzipped DuckDB warehouse archive. When set (and no local
# file or committed archive is present) the API downloads and inflates it on cold
# start. Lets the ~32MB archive be hosted off-git (object storage) instead of
# committed to the repo.
UNI_INTEL_DB_URL=

# --- Next.js web app (apps/web) ---
# Server-side API base URL (set on the Vercel web project to the production API).
# Default: http://127.0.0.1:8000
API_BASE_URL=

# Client/build-time API base URL. `make dev` sets this automatically for local
# development. Default: http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=
